# ---- Login -------------------------------------------------------------
APP_USERNAME=admin
# At least 8 characters. Use a long random one: the app is reachable from the internet.
APP_PASSWORD=
# At least 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_HOURS=168
# Set to true when the app is served over HTTPS (docker-compose.https.yml does this for you).
COOKIE_SECURE=false
# Set to true only when a reverse proxy you control sits in front and sets X-Forwarded-For.
TRUST_PROXY=false

# ---- Web server --------------------------------------------------------
APP_PORT=3000
# Use 127.0.0.1 to keep the port private (e.g. behind your own reverse proxy).
APP_BIND=0.0.0.0
MAX_UPLOAD_MB=5120

# ---- S3 ----------------------------------------------------------------
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for temporary (STS) credentials.
S3_SESSION_TOKEN=
# Leave empty for AWS S3. Set for S3-compatible services (R2, Spaces, B2, ...).
S3_ENDPOINT=
# Endpoint used in share links, if browsers reach S3 at a different address than the app does.
S3_PUBLIC_ENDPOINT=
# true = https://<bucket>.<endpoint>/key, false = https://<endpoint>/<bucket>/key
S3_VIRTUAL_HOSTED_STYLE=false
# Optional: keep everything under this key prefix inside the bucket, e.g. "storage-app/".
S3_PREFIX=
# Set to true for filesystem-backed S3 servers that still list a folder after it is emptied.
S3_PRUNE_EMPTY_FOLDERS=false

# ---- Only for docker-compose.https.yml ----------------------------------
DOMAIN=
